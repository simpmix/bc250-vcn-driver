/* bc250-vcn-driver v0.1.0 - https://github.com/Kai/bc250-vcn-driver */
#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba8) uniform readonly image2D inputRGBA;
layout(set = 0, binding = 1, r8) uniform writeonly image2D outputY;
layout(set = 0, binding = 2, rg8) uniform writeonly image2D outputUV;

layout(push_constant) uniform PushConstants {
    uint frame_width;
    uint frame_height;
    uint width_in_mbs;
    uint height_in_mbs;
    uint qp;
    uint is_intra;
    uint color_space; // 0 = BT.601, 1 = BT.709
    uint lambda_motion;
} pcs;

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= int(pcs.frame_width) || pos.y >= int(pcs.frame_height)) return;

    vec4 rgba = imageLoad(inputRGBA, pos);
    float R = rgba.r;
    float G = rgba.g;
    float B = rgba.b;

    float Y, U, V;
    if (pcs.color_space == 0) {
        // BT.601 standard
        Y = 0.299 * R + 0.587 * G + 0.114 * B;
        U = -0.1687 * R - 0.3313 * G + 0.5000 * B + 0.5;
        V = 0.5000 * R - 0.4187 * G - 0.0813 * B + 0.5;
    } else {
        // BT.709 HD standard
        Y = 0.2126 * R + 0.7152 * G + 0.0722 * B;
        U = -0.1146 * R - 0.3854 * G + 0.5000 * B + 0.5;
        V = 0.5000 * R - 0.4542 * G - 0.0458 * B + 0.5;
    }

    imageStore(outputY, pos, vec4(Y, 0.0, 0.0, 0.0));

    // NV12 4:2:0 subsampling: one UV pair per 2x2 luma block
    if ((pos.x & 1) == 0 && (pos.y & 1) == 0) {
        imageStore(outputUV, pos / 2, vec4(U, V, 0.0, 0.0));
    }
}
